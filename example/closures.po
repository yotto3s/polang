(* Closures - functions that capture variables from enclosing scope *)

(* Simple closure: function captures 'base' from outer scope *)
base = 10
add_base : i64 -> i64
add_base(x) = x + base
result1 = add_base(5)  (* 15 *)

(* Multiple captures: function captures a, b, c *)
a = 1
b = 2
c = 3
sum_all : i64
sum_all() = a + b + c
result2 = sum_all()  (* 6 *)

(* Final result *)
result1 + result2   (* 15 + 6 = 21 *)
