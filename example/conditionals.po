(* Conditional expressions with if/then/else *)
def max(a: i64, b: i64): i64 = if a > b then a else b
def abs(x: i64): i64 = if x < 0 then 0 - x else x
def sign(n: i64): i64 = if n > 0 then 1 else if n < 0 then 0 - 1 else 0  (* nested if *)

def result = max(abs(0 - 10), 5)  (* max(10, 5) *)
result                             (* result: 10 *)
