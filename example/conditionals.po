(* Conditional expressions with if/then/else *)
max : i64 * i64 -> i64
max(a, b) = if a > b then a else b
abs : i64 -> i64
abs(x) = if x < 0 then 0 - x else x
sign : i64 -> i64
sign(n) = if n > 0 then 1 else if n < 0 then 0 - 1 else 0  (* nested if *)

result = max(abs(0 - 10), 5)  (* max(10, 5) *)
result                             (* result: 10 *)
