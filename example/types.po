(* Type system demonstration *)
i : i64
i = 42  (* integer type *)
d : f64
d = 3.14159  (* double type *)
b : bool
b = true  (* boolean type *)

(* Comparisons return bool *)
is_positive : bool
is_positive = i > 0
is_large : bool
is_large = d > 3.0

if is_positive then i * 2 else 0  (* result: 84 *)
