(* Function declarations and calls *)
square : i64 -> i64
square(n) = n * n  (* single parameter function *)
add : i64 * i64 -> i64
add(a, b) = a + b  (* multi-parameter function *)
result = add(square(3), square(4))  (* nested function calls: 9 + 16 *)
result                                         (* result: 25 *)
