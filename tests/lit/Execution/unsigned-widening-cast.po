(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test unsigned integer widening cast (ExtUIOp) *)
(* u8 -> u64 should zero-extend *)
widen_u8 : u8 -> u64
widen_u8(x) = x as u64

(* u16 -> u32 should zero-extend *)
widen_u16 : u16 -> u32
widen_u16(x) = x as u32

(* CHECK: 255 : u64
*)
widen_u8(255 as u8)
