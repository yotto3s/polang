(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test float narrowing cast (f64 -> f32 -> f64 round trip) *)
narrow_and_widen : f64 -> f64
narrow_and_widen(x) = (x as f32) as f64

(* 3.14 should survive f64->f32->f64 round trip (with some precision loss) *)
(* CHECK: 3.14{{.*}} : f64
*)
narrow_and_widen(3.14)
