(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test f32 float constant lowering *)
(* A function with f32 return type forces the float literal to be f32 *)
f32_val : f64 -> f32
f32_val(x) = x as f32

(* Round-trip through f32 to verify the constant path works *)
f32_roundtrip : f64 -> f64
f32_roundtrip(x) = (x as f32) as f64

(* CHECK: 2.5 : f64
*)
f32_roundtrip(2.5)
