(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test unsigned division uses correct LLVM instruction (DivUI vs DivSI) *)
(* For unsigned types, division should treat operands as unsigned *)

div_u64 : u64 * u64 -> u64
div_u64(a, b) = a / b

(* Test: 100 / 10 = 10 (same result for signed and unsigned) *)
result = div_u64(100 as u64, 10 as u64)

(* CHECK: 10 : u64
*)
result
