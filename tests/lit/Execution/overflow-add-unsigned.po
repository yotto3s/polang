(* Test unsigned integer overflow on addition *)
(* 3 * (2^63 - 1) > 2^64, so the second addition overflows u64 *)

(* CHECK: {{.*}}Runtime error: integer overflow{{.*}}
*)

:{
addThree : u64 -> u64
addThree(x) = x + x + x
:}
addThree(9223372036854775807)
