(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test all comparison operators *)
lt : i64 * i64 -> bool
lt(a, b) = a < b
le : i64 * i64 -> bool
le(a, b) = a <= b
gt : i64 * i64 -> bool
gt(a, b) = a > b
ge : i64 * i64 -> bool
ge(a, b) = a >= b
eq : i64 * i64 -> bool
eq(a, b) = a == b
ne : i64 * i64 -> bool
ne(a, b) = a != b

(* Test less-than: 1 < 2 = true, 2 < 1 = false *)
(* First we need a way to combine results *)
(* Use integer encoding: true=1, false=0 *)
btoi : bool -> i64
btoi(b) = if b then 1 else 0

(* Sum all expected true comparisons *)
result =
  btoi(lt(1, 2)) +
  btoi(le(1, 2)) +
  btoi(le(2, 2)) +
  btoi(gt(2, 1)) +
  btoi(ge(2, 1)) +
  btoi(ge(2, 2)) +
  btoi(eq(2, 2)) +
  btoi(ne(1, 2))

(* CHECK: 8 : i64
*)
result
