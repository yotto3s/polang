; RUN: %polang_repl %s | %FileCheck %s

; Test all comparison operators
def lt(a: i64, b: i64): bool = a < b
def le(a: i64, b: i64): bool = a <= b
def gt(a: i64, b: i64): bool = a > b
def ge(a: i64, b: i64): bool = a >= b
def eq(a: i64, b: i64): bool = a == b
def ne(a: i64, b: i64): bool = a != b

; Test less-than: 1 < 2 = true, 2 < 1 = false
; First we need a way to combine results
; Use integer encoding: true=1, false=0
def btoi(b: bool): i64 = if b then 1 else 0

; Sum all expected true comparisons
def result =
  btoi(lt(1, 2)) +
  btoi(le(1, 2)) +
  btoi(le(2, 2)) +
  btoi(gt(2, 1)) +
  btoi(ge(2, 1)) +
  btoi(ge(2, 2)) +
  btoi(eq(2, 2)) +
  btoi(ne(1, 2))

; CHECK: 8 : i64
result
