(* RUN: %polang_repl %s | %FileCheck %s
*)

(* Test float less-than *)
a = 1.5 < 2.0
(* Test float greater-than *)
b = 3.0 > 2.0
(* Test float equality *)
c = 1.0 == 1.0
(* Test float not-equal *)
d = 1.0 != 2.0
(* Test float less-or-equal *)
e = 2.0 <= 2.0
(* Test float greater-or-equal *)
f = 3.0 >= 2.0

(* All comparisons should be true, use conditional to verify *)
(* CHECK: 1 : i64
*)
if a then (if b then (if c then (if d then (if e then (if f then 1 else 0) else 0) else 0) else 0) else 0) else 0
