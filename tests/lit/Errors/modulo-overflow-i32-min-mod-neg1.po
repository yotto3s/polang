(* RUN: %not %polang_repl %s 2>&1 | %FileCheck %s
*)

(* F1: RemOpLowering does not guard against MIN_INT % -1 overflow
   for i32. Same underlying issue as the i64 case: LLVM srem is
   undefined behavior for MIN_INT % -1, causing SIGFPE on x86.
   This test exercises the i32 bit width variant.
*)

(* CHECK: Runtime error: integer overflow at line {{[0-9]+}}, column {{[0-9]+}}
*)

:{
remIt : i32 * i32 -> i32
remIt(a, b) = a % b
:}
remIt((0 as i32) - (2147483647 as i32) - (1 as i32), (0 as i32) - (1 as i32))
