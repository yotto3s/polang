(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test MLIR representation of signed integer types (i8, i16, i32, i64) *)

(* Function with i8 parameters *)
(* CHECK: {{.*}}polang.func @add_i8(%{{.*}}: si8, %{{.*}}: si8) -> si8{{.*}}
*)
add_i8 : i8 * i8 -> i8
add_i8(a, b) = a + b

(* Function with i16 parameters *)
(* CHECK: {{.*}}polang.func @add_i16(%{{.*}}: si16, %{{.*}}: si16) -> si16{{.*}}
*)
add_i16 : i16 * i16 -> i16
add_i16(a, b) = a + b

(* Function with i32 parameters *)
(* CHECK: {{.*}}polang.func @add_i32(%{{.*}}: si32, %{{.*}}: si32) -> si32{{.*}}
*)
add_i32 : i32 * i32 -> i32
add_i32(a, b) = a + b

(* Function with i64 parameters *)
(* CHECK: {{.*}}polang.func @add_i64(%{{.*}}: si64, %{{.*}}: si64) -> si64{{.*}}
*)
add_i64 : i64 * i64 -> i64
add_i64(a, b) = a + b

(* Default expression *)
42
