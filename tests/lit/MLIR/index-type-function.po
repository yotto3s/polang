(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test MLIR generation for functions with isize/usize parameter and return types *)
(* CHECK:  polang.func @to_i64(%{{.*}}: index) -> si64 {
*)
(* CHECK-NEXT:    %{{[0-9]+}} = polang.cast %{{.*}} : index -> si64
*)
(* CHECK:  polang.func @to_usize(%{{.*}}: si64) -> index {
*)
(* CHECK-NEXT:    %{{[0-9]+}} = polang.cast %{{.*}} : si64 -> index
*)
to_i64 : isize -> i64
to_i64(x) = x as i64
to_usize : i64 -> usize
to_usize(x) = x as usize
to_i64(42 as isize)
