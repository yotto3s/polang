(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test MLIR generation for functions with isize/usize parameter and return types *)
(* CHECK:  polang.func @to_i64(%{{.*}}: !polang.index<signed>) -> !polang.integer<64, signed> {
*)
(* CHECK-NEXT:    %{{[0-9]+}} = polang.cast %{{.*}} : !polang.index<signed> -> !polang.integer<64, signed>
*)
(* CHECK:  polang.func @to_usize(%{{.*}}: !polang.integer<64, signed>) -> !polang.index<unsigned> {
*)
(* CHECK-NEXT:    %{{[0-9]+}} = polang.cast %{{.*}} : !polang.integer<64, signed> -> !polang.index<unsigned>
*)
to_i64 : isize -> i64
to_i64(x) = x as i64
to_usize : i64 -> usize
to_usize(x) = x as usize
to_i64(42 as isize)
