(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Functions with untyped parameters resolved by AST-level TypeChecker. *)
(* Body operations constrain the types to concrete values. *)

(* Function resolved to integer (a + 0 constrains to integer) *)
(* CHECK: {{.*}}polang.func @add3(%{{.*}}: !polang.integer<64, signed>, %{{.*}}: !polang.integer<64, signed>, %{{.*}}: !polang.integer<64, signed>) -> !polang.integer<64, signed>{{.*}}
*)
def add3(a, b, c) = (a + 0) + (b + 0) + (c + 0)

(* Function resolved to float (a * 1.0 constrains to float) *)
(* CHECK: {{.*}}polang.func @scale3(%{{.*}}: !polang.float<64>, %{{.*}}: !polang.float<64>, %{{.*}}: !polang.float<64>) -> !polang.float<64>{{.*}}
*)
def scale3(a, b, c) = (a * 1.0) + (b * 1.0) + (c * 1.0)

(* Partially typed function (both resolve to i64) *)
(* CHECK: {{.*}}polang.func @add_typed(%{{.*}}: !polang.integer<64, signed>, %{{.*}}: !polang.integer<64, signed>) -> !polang.integer<64, signed>{{.*}}
*)
def add_typed(x: i64, y) = x + y

(* Call functions *)
add3(1, 2, 3)
scale3(1.0, 2.0, 3.0)
add_typed(1, 2)
