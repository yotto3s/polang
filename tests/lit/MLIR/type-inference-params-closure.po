(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Captured variable with inferred parameter *)
base = 10
(* CHECK: {{.*}}polang.func @add_base(%{{.*}}: si64) -> si64{{.*}}
*)
add_base(x) = x + base

(* Double captured variable with inferred parameter *)
factor = 2.5
(* CHECK: {{.*}}polang.func @scale(%{{.*}}: f64) -> f64{{.*}}
*)
scale(x) = x * factor

(* Entry point *)
0
