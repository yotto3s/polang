(* Since there are no call sites, no specialized version is created. *)

(* Only the entry function should remain *)
(* CHECK: {{.*}}polang.func @__polang_entry(){{.*}} *)

(* The unused function should not exist in any form *)
(* CHECK-NOT: @unused_identity *)

def unused_identity(x) = x
42
