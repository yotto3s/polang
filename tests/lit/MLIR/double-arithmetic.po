(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test double addition *)
(* CHECK:      polang.func @dadd(%arg0: !polang.float<64>, %arg1: !polang.float<64>) -> !polang.float<64> {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.add %arg0, %arg1 : !polang.float<64>, !polang.float<64> -> !polang.float<64>
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : !polang.float<64>
*)
(* CHECK-NEXT: }
*)
dadd : f64 * f64 -> f64
dadd(a, b) = a + b

(* Test double subtraction *)
(* CHECK:      polang.func @dsub(%arg0: !polang.float<64>, %arg1: !polang.float<64>) -> !polang.float<64> {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.sub %arg0, %arg1 : !polang.float<64>, !polang.float<64> -> !polang.float<64>
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : !polang.float<64>
*)
(* CHECK-NEXT: }
*)
dsub : f64 * f64 -> f64
dsub(a, b) = a - b

(* Test double multiplication *)
(* CHECK:      polang.func @dmul(%arg0: !polang.float<64>, %arg1: !polang.float<64>) -> !polang.float<64> {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.mul %arg0, %arg1 : !polang.float<64>, !polang.float<64> -> !polang.float<64>
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : !polang.float<64>
*)
(* CHECK-NEXT: }
*)
dmul : f64 * f64 -> f64
dmul(a, b) = a * b

(* Test double division *)
(* CHECK:      polang.func @ddiv(%arg0: !polang.float<64>, %arg1: !polang.float<64>) -> !polang.float<64> {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.div %arg0, %arg1 : !polang.float<64>, !polang.float<64> -> !polang.float<64>
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : !polang.float<64>
*)
(* CHECK-NEXT: }
*)
ddiv : f64 * f64 -> f64
ddiv(a, b) = a / b
