(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test less-than comparison *)
(* CHECK:      polang.func @cmp_lt(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp lt, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_lt : i64 * i64 -> bool
cmp_lt(a, b) = a < b

(* Test less-or-equal comparison *)
(* CHECK:      polang.func @cmp_le(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp le, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_le : i64 * i64 -> bool
cmp_le(a, b) = a <= b

(* Test greater-than comparison *)
(* CHECK:      polang.func @cmp_gt(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp gt, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_gt : i64 * i64 -> bool
cmp_gt(a, b) = a > b

(* Test greater-or-equal comparison *)
(* CHECK:      polang.func @cmp_ge(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp ge, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_ge : i64 * i64 -> bool
cmp_ge(a, b) = a >= b

(* Test equality comparison *)
(* CHECK:      polang.func @cmp_eq(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp eq, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_eq : i64 * i64 -> bool
cmp_eq(a, b) = a == b

(* Test not-equal comparison *)
(* CHECK:      polang.func @cmp_ne(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp ne, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
cmp_ne : i64 * i64 -> bool
cmp_ne(a, b) = a != b
