(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test double constant *)
(* CHECK:      polang.func @double_val() -> f64 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.constant.float 3.140000e+00 : f64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : f64
*)
(* CHECK-NEXT: }
*)
double_val : () -> f64
double_val() = 3.14

(* Test bool constant *)
(* CHECK:      polang.func @bool_val() -> i1 {
*)
(* CHECK-NEXT:   %true = arith.constant true
*)
(* CHECK-NEXT:   polang.return %true : i1
*)
(* CHECK-NEXT: }
*)
bool_val : () -> bool
bool_val() = true
