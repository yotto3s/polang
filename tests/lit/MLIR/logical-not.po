(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test logical not operator *)
(* CHECK:      polang.func @logical_not(%arg0: i1) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.not %arg0 : i1
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
logical_not : bool -> bool
logical_not(x) = !x

(* Test negation of boolean literal *)
(* CHECK:      polang.func @not_true() -> i1 {
*)
(* CHECK-NEXT:   %true = arith.constant true
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.not %true : i1
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
not_true : () -> bool
not_true() = !true

(* Test negation of comparison *)
(* CHECK:      polang.func @not_comparison(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp gt, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.not %{{[0-9]+}} : i1
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : i1
*)
(* CHECK-NEXT: }
*)
not_comparison : i64 * i64 -> bool
not_comparison(a, b) = !(a > b)
