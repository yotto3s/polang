; RUN: %polang_compiler --emit-mlir %s | %FileCheck %s

; Test polymorphic identity function with monomorphization.
; The AST-level TypeChecker detects the function is polymorphic,
; and monomorphization creates a specialized version for the call site.

; The entry function calls the specialized version
; CHECK-DAG: {{.*}}polang.func @__polang_entry() -> !polang.integer<64, signed>{{.*}}

; The specialized identity function with concrete types
; CHECK-DAG: {{.*}}polang.func @identity$i64(%{{.*}}: !polang.integer<64, signed>) -> !polang.integer<64, signed>{{.*}}

; The original generic function is erased after monomorphization
; CHECK-NOT: polang.generic_func

def identity(x) = x
identity(42)
