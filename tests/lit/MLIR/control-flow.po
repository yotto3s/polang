(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test if-expression in MLIR *)
(* CHECK:      polang.func @max(%arg0: si64, %arg1: si64) -> si64 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.cmp gt, %arg0, %arg1 : si64, si64
*)
(* CHECK-NEXT:   %{{[0-9]+}} = scf.if %{{[0-9]+}} -> (si64) {
*)
(* CHECK-NEXT:     scf.yield %arg0 : si64
*)
(* CHECK-NEXT:   } else {
*)
(* CHECK-NEXT:     scf.yield %arg1 : si64
*)
(* CHECK-NEXT:   }
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : si64
*)
(* CHECK-NEXT: }
*)
max : i64 * i64 -> i64
max(a, b) = if a > b then a else b
