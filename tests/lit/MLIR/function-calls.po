(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test function call *)
(* CHECK:      polang.func @__polang_entry() -> si64 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.constant.integer 1 : si64
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.constant.integer 2 : si64
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.call @add(%{{[0-9]+}}, %{{[0-9]+}}) : (si64, si64) -> si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : si64
*)
(* CHECK-NEXT: }
*)

(* CHECK:      polang.func @add(%arg0: si64, %arg1: si64) -> si64 {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.add %arg0, %arg1 : si64, si64 -> si64
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : si64
*)
(* CHECK-NEXT: }
*)
add : i64 * i64 -> i64
add(a, b) = a + b
add(1, 2)
