(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test function with type inference from comparison. *)
(* The AST-level TypeChecker resolves the parameter type from context (x == 0 *)
(* constrains x to integer), so the function is emitted as monomorphic. *)

(* Monomorphic function with concrete types (resolved by AST TypeChecker) *)
(* CHECK: {{.*}}polang.func @is_zero(%{{.*}}: si64) -> i1{{.*}}
*)

(* Verify comparison operation with concrete types *)
(* CHECK: {{.*}}polang.cmp eq{{.*}}si64{{.*}}
*)

is_zero(x) = x == 0
is_zero(5)
