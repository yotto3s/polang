(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test logical or operator with short-circuit evaluation *)
(* CHECK:      polang.func @logical_or(%arg0: i1, %arg1: i1) -> i1 {
*)
(* CHECK-NEXT:   %0 = scf.if %arg0 -> (i1) {
*)
(* CHECK-NEXT:     %true = arith.constant true
*)
(* CHECK-NEXT:     scf.yield %true : i1
*)
(* CHECK-NEXT:   } else {
*)
(* CHECK-NEXT:     scf.yield %arg1 : i1
*)
(* CHECK-NEXT:   }
*)
(* CHECK-NEXT:   polang.return %0 : i1
*)
(* CHECK-NEXT: }
*)
logical_or : bool * bool -> bool
logical_or(a, b) = a || b

(* Test compound logical or *)
(* CHECK:      polang.func @compound_or(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK:        %[[CMP1:.*]] = polang.cmp eq, %arg0, %{{.*}} : si64, si64
*)
(* CHECK:        %{{.*}} = scf.if %[[CMP1]] -> (i1) {
*)
(* CHECK:          %true{{.*}} = arith.constant true
*)
(* CHECK:          scf.yield %true{{.*}} : i1
*)
(* CHECK:        } else {
*)
(* CHECK:          %[[CMP2:.*]] = polang.cmp eq, %arg1, %{{.*}} : si64, si64
*)
(* CHECK:          scf.yield %[[CMP2]] : i1
*)
(* CHECK:        }
*)
(* CHECK:        polang.return %{{.*}} : i1
*)
(* CHECK:      }
*)
compound_or : i64 * i64 -> bool
compound_or(a, b) = a == 0 || b == 0
