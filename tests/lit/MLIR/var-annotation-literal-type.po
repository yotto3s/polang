(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s *)

(* Test that type annotations propagate to literal MLIR types *)

(* CHECK:      module { *)
(* CHECK-NEXT:   polang.func @__polang_entry() -> !polang.float<32> { *)
(* CHECK-NEXT:     %{{[0-9]+}} = polang.constant.integer 5 : !polang.integer<32, signed> *)
(* CHECK-NEXT:     %{{[0-9]+}} = polang.constant.float {{.*}} : !polang.float<32> *)
def x: i32 = 5
def y: f32 = 3.0

y
