(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test logical and operator with short-circuit evaluation *)
(* CHECK:      polang.func @logical_and(%arg0: i1, %arg1: i1) -> i1 {
*)
(* CHECK-NEXT:   %0 = scf.if %arg0 -> (i1) {
*)
(* CHECK-NEXT:     scf.yield %arg1 : i1
*)
(* CHECK-NEXT:   } else {
*)
(* CHECK-NEXT:     %false = arith.constant false
*)
(* CHECK-NEXT:     scf.yield %false : i1
*)
(* CHECK-NEXT:   }
*)
(* CHECK-NEXT:   polang.return %0 : i1
*)
(* CHECK-NEXT: }
*)
logical_and : bool * bool -> bool
logical_and(a, b) = a && b

(* Test compound logical and *)
(* CHECK:      polang.func @compound_and(%arg0: si64, %arg1: si64) -> i1 {
*)
(* CHECK:        %[[CMP1:.*]] = polang.cmp gt, %arg0, %{{.*}} : si64, si64
*)
(* CHECK:        %{{.*}} = scf.if %[[CMP1]] -> (i1) {
*)
(* CHECK:          %[[CMP2:.*]] = polang.cmp lt, %arg0, %{{.*}} : si64, si64
*)
(* CHECK:          scf.yield %[[CMP2]] : i1
*)
(* CHECK:        } else {
*)
(* CHECK:          %false{{.*}} = arith.constant false
*)
(* CHECK:          scf.yield %false{{.*}} : i1
*)
(* CHECK:        }
*)
(* CHECK:        polang.return %{{.*}} : i1
*)
(* CHECK:      }
*)
compound_and : i64 * i64 -> bool
compound_and(a, b) = a > 0 && a < 100
