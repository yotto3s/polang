(* RUN: %polang_compiler --emit-mlir %s | %FileCheck %s
*)

(* Test logical and operator with short-circuit evaluation *)
(* CHECK:      polang.func @logical_and(%arg0: !polang.bool, %arg1: !polang.bool) -> !polang.bool {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = polang.if %arg0 : !polang.bool -> !polang.bool {
*)
(* CHECK-NEXT:     polang.yield %arg1 : !polang.bool
*)
(* CHECK-NEXT:   } else {
*)
(* CHECK-NEXT:     %{{[0-9]+}} = polang.constant.bool false : !polang.bool
*)
(* CHECK-NEXT:     polang.yield %{{[0-9]+}} : !polang.bool
*)
(* CHECK-NEXT:   }
*)
(* CHECK-NEXT:   polang.return %{{[0-9]+}} : !polang.bool
*)
(* CHECK-NEXT: }
*)
logical_and : bool * bool -> bool
logical_and(a, b) = a && b

(* Test compound logical and *)
(* CHECK:      polang.func @compound_and(%arg0: !polang.integer<64, signed>, %arg1: !polang.integer<64, signed>) -> !polang.bool {
*)
(* CHECK:        %{{[0-9]+}} = polang.cmp gt, %arg0, %{{[0-9]+}} : !polang.integer<64, signed>, !polang.integer<64, signed>
*)
(* CHECK:        %{{[0-9]+}} = polang.if %{{[0-9]+}} : !polang.bool -> !polang.bool {
*)
(* CHECK:          %{{[0-9]+}} = polang.cmp lt, %arg0, %{{[0-9]+}} : !polang.integer<64, signed>, !polang.integer<64, signed>
*)
(* CHECK:          polang.yield %{{[0-9]+}} : !polang.bool
*)
(* CHECK:        } else {
*)
(* CHECK:          %{{[0-9]+}} = polang.constant.bool false : !polang.bool
*)
(* CHECK:          polang.yield %{{[0-9]+}} : !polang.bool
*)
(* CHECK:        }
*)
(* CHECK:        polang.return %{{[0-9]+}} : !polang.bool
*)
(* CHECK:      }
*)
compound_and : i64 * i64 -> bool
compound_and(a, b) = a > 0 && a < 100
