(* RUN: %polang_compiler --dump-ast %s | %FileCheck %s
*)

(* Test isize/usize in function parameter and return type annotations *)
(* CHECK:      NBlock
*)
(* CHECK-NEXT: |-NTypeSignature 'make_isize' : i64 -> isize
*)
(* CHECK-NEXT: |-NFunctionDeclaration 'make_isize' (x)
*)
(* CHECK:      |-NTypeSignature 'to_i64' : isize -> i64
*)
(* CHECK-NEXT: |-NFunctionDeclaration 'to_i64' (x)
*)
(* CHECK:      `-NExpressionStatement
*)
(* CHECK-NEXT:   `-NMethodCall 'to_i64'
*)
(* CHECK-NEXT:     `-NMethodCall 'make_isize'
*)
(* CHECK-NEXT:       `-NInteger 42
*)
make_isize : i64 -> isize
make_isize(x) = x as isize
to_i64 : isize -> i64
to_i64(x) = x as i64
to_i64(make_isize(42))
