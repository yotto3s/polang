(* RUN: %polang_compiler --dump-ast %s | %FileCheck %s
*)

(* Test module declaration AST with exports *)
(* CHECK:      NBlock
*)
(* CHECK-NEXT: `-NModuleDeclaration 'Math' (add, sub, PI)
*)
(* CHECK-NEXT:   |-NVariableDeclaration 'PI'
*)
(* CHECK-NEXT:   | `-NDouble 3.14159
*)
(* CHECK-NEXT:   |-NTypeSignature 'add' : i64 * i64 -> i64
*)
(* CHECK-NEXT:   |-NFunctionDeclaration 'add' (x, y)
*)
(* CHECK-NEXT:   | `-NBlock
*)
(* CHECK-NEXT:   |   `-NExpressionStatement
*)
(* CHECK-NEXT:   |     `-NBinaryOperator '+'
*)
(* CHECK-NEXT:   |       |-NIdentifier 'x'
*)
(* CHECK-NEXT:   |       `-NIdentifier 'y'
*)
(* CHECK-NEXT:   |-NTypeSignature 'sub' : i64 * i64 -> i64
*)
(* CHECK-NEXT:   |-NFunctionDeclaration 'sub' (x, y)
*)
(* CHECK-NEXT:   | `-NBlock
*)
(* CHECK-NEXT:   |   `-NExpressionStatement
*)
(* CHECK-NEXT:   |     `-NBinaryOperator '-'
*)
(* CHECK-NEXT:   |       |-NIdentifier 'x'
*)
(* CHECK-NEXT:   |       `-NIdentifier 'y'
*)
(* CHECK-NEXT:   |-NTypeSignature 'internal_helper' : i64 -> i64
*)
(* CHECK-NEXT:   `-NFunctionDeclaration 'internal_helper' (x)
*)
(* CHECK-NEXT:     `-NBlock
*)
(* CHECK-NEXT:       `-NExpressionStatement
*)
(* CHECK-NEXT:         `-NBinaryOperator '*'
*)
(* CHECK-NEXT:           |-NIdentifier 'x'
*)
(* CHECK-NEXT:           `-NInteger 2
*)

module Math (add, sub, PI)
  PI = 3.14159
  add : i64 * i64 -> i64
  add(x, y) = x + y
  sub : i64 * i64 -> i64
  sub(x, y) = x - y
  internal_helper : i64 -> i64
  internal_helper(x) = x * 2
endmodule
