(* RUN: %polang_compiler %s | %FileCheck %s
*)

(* Test less-than comparison *)
(* CHECK:      define i1 @cmp_lt(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp slt i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_lt : i64 * i64 -> bool
cmp_lt(a, b) = a < b

(* Test less-or-equal comparison *)
(* CHECK:      define i1 @cmp_le(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp sle i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_le : i64 * i64 -> bool
cmp_le(a, b) = a <= b

(* Test greater-than comparison *)
(* CHECK:      define i1 @cmp_gt(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp sgt i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_gt : i64 * i64 -> bool
cmp_gt(a, b) = a > b

(* Test greater-or-equal comparison *)
(* CHECK:      define i1 @cmp_ge(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp sge i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_ge : i64 * i64 -> bool
cmp_ge(a, b) = a >= b

(* Test equality comparison *)
(* CHECK:      define i1 @cmp_eq(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp eq i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_eq : i64 * i64 -> bool
cmp_eq(a, b) = a == b

(* Test not-equal comparison *)
(* CHECK:      define i1 @cmp_ne(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp ne i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
cmp_ne : i64 * i64 -> bool
cmp_ne(a, b) = a != b
