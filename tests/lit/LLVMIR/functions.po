(* Test entry point function with function call *)
(* CHECK:      define i64 @__polang_entry() {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = call i64 @square(i64 5)
*)
(* CHECK-NEXT:   ret i64 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
square : i64 -> i64
square(x) = x * x
square(5)

