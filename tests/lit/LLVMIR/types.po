(* RUN: %polang_compiler %s | %FileCheck %s
*)

(* Test double type operations *)
(* CHECK:      define double @fadd(double %{{[0-9]+}}, double %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = fadd double %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret double %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
fadd : f64 * f64 -> f64
fadd(a, b) = a + b

(* Test integer comparison returning bool *)
(* CHECK:      define i1 @lt(i64 %{{[0-9]+}}, i64 %{{[0-9]+}}) {
*)
(* CHECK-NEXT:   %{{[0-9]+}} = icmp slt i64 %{{[0-9]+}}, %{{[0-9]+}}
*)
(* CHECK-NEXT:   ret i1 %{{[0-9]+}}
*)
(* CHECK-NEXT: }
*)
lt : i64 * i64 -> bool
lt(a, b) = a < b
